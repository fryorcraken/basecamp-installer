#!/bin/sh
# A sha256 tool that works once and then breaks, for the storage-round-trip
# unit tests. The check hashes its test content first and the fetched content
# second, so the second call is the one that verifies the download.
#
# NO SPEC: that order. The spec fixes only that the test content is hashed
# before it is uploaded; how often the tool runs, and what it is run on after
# that, is outside the capability.
#
# With the knob file $STUB_STATE/sha-prints-nothing the broken calls exit 0
# and print nothing; without it they exit 1.

set -u
state=${STUB_STATE:?STUB_STATE is not set}

calls=0
[ -f "$state/sha-calls" ] && calls=$(cat "$state/sha-calls")
calls=$((calls + 1))
printf '%s\n' "$calls" >"$state/sha-calls"

first_broken_call=2
# With the knob file $STUB_STATE/sha-broken-from-first the very first call, on
# the test content, is broken too: two broken calls give two equal "digests".
[ -f "$state/sha-broken-from-first" ] && first_broken_call=1

if [ "$calls" -ge "$first_broken_call" ]; then
	[ -f "$state/sha-prints-nothing" ] && exit 0
	exit 1
fi
# shellcheck disable=SC2086
exec ${STUB_REAL_SHA256:?STUB_REAL_SHA256 is not set}
